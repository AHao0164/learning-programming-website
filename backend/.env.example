# ==============================
# SERVER CONFIG
# ==============================
PORT=5000
NODE_ENV=development

# ==============================
# DATABASE
# Giữ nguyên nếu dùng Docker Compose
# ==============================
MONGO_URI=mongodb://mongo:27017/ai-coding-platform

# ==============================
# JWT (Đổi thành chuỗi bí mật bất kỳ, ít nhất 32 ký tự)
# ==============================
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRE=30d

# ==============================
# GOOGLE GEMINI AI
# Lấy tại: https://aistudio.google.com/app/apikey
# ==============================
GEMINI_API_KEY=

# ==============================
# VNPAY SANDBOX (Thanh toán)
# Đăng ký tại: https://sandbox.vnpayment.vn/
# ==============================
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5000/api/v1/payment/vnpay_return

# ==============================
# EMAIL (Gmail SMTP)
# Hướng dẫn: myaccount.google.com → Security → App passwords
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME="HK Learning Platform"

# ==============================
# GOOGLE OAUTH
# Lấy tại: https://console.cloud.google.com/ → Credentials
# ==============================
GOOGLE_CLIENT_ID=

# ==============================
# CORS (danh sách origins phân tách bởi dấu phẩy)
# ==============================
CORS_ORIGINS=http://localhost:5173

# ==============================
# REDIS (Giữ nguyên nếu dùng Docker Compose)
# ==============================
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false
